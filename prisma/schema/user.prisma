model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  phone        String?

  role         Role
  status       UserStatus @default(ACTIVE)

  // One-to-One Relation
  profile Profile?

  // One-to-Many Relations
  properties     Property[]
  rentalRequests RentalRequest[]
  reviews        Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}